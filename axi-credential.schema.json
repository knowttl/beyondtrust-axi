{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/knowttl/beyondtrust-axi/axi-credential.schema.json",
  "title": "BeyondTrust PM Cloud AXI credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "clientId"
  ],
  "properties": {
    "clientId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "clientSecret": {
      "$ref": "#/$defs/secretRef",
      "x-secret": true,
      "default": {
        "env": "BEYONDTRUST_AXI_CLIENT_SECRET"
      }
    },
    "downloads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow"
      ],
      "default": {
        "allow": false
      },
      "properties": {
        "allow": {
          "type": "boolean"
        }
      }
    },
    "writes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowWrites",
        "operations"
      ],
      "default": {
        "allowWrites": false,
        "operations": [],
        "allowDeletes": false
      },
      "properties": {
        "allowWrites": {
          "type": "boolean"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_.-]*$"
          }
        },
        "allowDeletes": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+beyondtrustcloud\\.com$"
    }
  },
  "$defs": {
    "secretRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "env"
          ],
          "properties": {
            "env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
            }
          }
        }
      ]
    }
  }
}
