{
  "name": "@knowttl/beyondtrust-axi",
  "version": "0.1.6",
  "description": "Inspect BeyondTrust PM Cloud Endpoint Privilege Management through guarded AXI commands",
  "license": "MIT",
  "type": "module",
  "bin": {
    "beyondtrust-axi": "bin/beyondtrust-axi.js",
    "beyondtrust-axi-hook": "bin/beyondtrust-axi-hook.js"
  },
  "exports": {
    "./catalogue": "./dist/src/catalogue.js",
    "./inventory": "./inventory/capabilities.json",
    "./axi-credential.schema.json": "./axi-credential.schema.json"
  },
  "files": [
    "bin",
    "dist/src",
    "inventory",
    "axi-credential.schema.json",
    "docs",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/beyondtrust-axi.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.tooling.json",
    "lint": "corepack pnpm run typecheck",
    "test": "node scripts/isolated.ts node scripts/test.ts",
    "docs:generate": "node scripts/generate-docs.ts",
    "docs:check": "node scripts/generate-docs.ts --check",
    "spec:check": "node scripts/specs.ts --check",
    "identifiers:check": "node scripts/check-identifiers.ts"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.13",
    "smol-toml": "1.6.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
